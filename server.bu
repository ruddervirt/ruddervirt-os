# SPDX-License-Identifier: GPL-3.0-only
variant: fcos
version: 1.6.0
passwd:
  users:
    # Default password is "ruddervirt" for both root and admin. This is a
    # well-known default meant to be changed by the post-install setup script.
    - name: root
      password_hash: "$6$ruddervirt0$hVyBGZxUjDrV7kW.cEWoJxBLIWzCDxPDRjE3NgDEmeAMoNEpXoJa2fR6PGEKu5dnI78I22zK5z1cC.IEDOnAZ/"
    - name: admin
      groups: ["wheel", "sudo"]
      password_hash: "$6$ruddervirt0$hVyBGZxUjDrV7kW.cEWoJxBLIWzCDxPDRjE3NgDEmeAMoNEpXoJa2fR6PGEKu5dnI78I22zK5z1cC.IEDOnAZ/"
      # Login shell launches the ruddervirt-setup menu (console and SSH) and
      # falls back to bash for non-interactive use and the menu's shell escape.
      shell: /usr/local/bin/ruddervirt-shell
    - name: rudderadmin
      groups: ["wheel", "sudo"]
systemd:
  units:
    - name: "rudderadmin-key-sync-setup.service"
      enabled: true
      contents: |
        [Unit]
        Description=rudderadmin Key Sync Setup
        Wants=systemd-remount-fs.service local-fs.target network-online.target
        After=systemd-remount-fs.service local-fs.target network-online.target
        ConditionPathExists=!/var/.rudderadmin-key-sync-installed

        [Service]
        Type=oneshot
        ExecStartPre=/bin/bash -c 'curl -Lo /var/opt/ssh-key-sync_linux_amd64.tar.gz https://github.com/shoenig/ssh-key-sync/releases/download/v1.7.3/ssh-key-sync_1.7.3_linux_amd64.tar.gz'    
        ExecStartPre=/bin/bash -c 'tar -xzf /var/opt/ssh-key-sync_linux_amd64.tar.gz -C /usr/local/bin/ ssh-key-sync'
        ExecStartPre=/bin/bash -c 'touch /var/.rudderadmin-key-sync-installed'
        ExecStart=/bin/bash -c 'exit 0'

        [Install]
        WantedBy=multi-user.target
    - name: "rudderadmin-key-sync.service"
      enabled: true
      contents: |
        [Unit]
        Description=Synchronize ssh authorized keys for rudderadmin
        Wants=network-online.target rudderadmin-key-sync-setup.service
        After=network-online.target rudderadmin-key-sync-setup.service

        [Service]
        User=rudderadmin
        ExecStartPre=-/bin/mkdir -p /home/rudderadmin/.ssh
        ExecStartPre=-/bin/touch /home/rudderadmin/.ssh/authorized_keys
        ExecStart=/usr/local/bin/ssh-key-sync -verbose -system-user rudderadmin -github-user rudder-virt

        [Install]
        WantedBy=multi-user.target
    - name: "rudderadmin-key-sync.timer"
      enabled: true
      contents: |
        [Unit]
        Description=Synchronize ssh authorized keys for rudderadmin

        [Timer]
        OnBootSec=5min
        OnUnitActiveSec=24h
        Persistent=true
        Unit=rudderadmin-key-sync.service

        [Install]
        WantedBy=timers.target
    - name: "brand-ruddervirt.service"
      enabled: true
      contents: |
        [Unit]
        Description=Apply RudderVirt OS branding (os-release, boot menu)
        After=local-fs.target
        RequiresMountsFor=/boot
        Before=systemd-user-sessions.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/brand-ruddervirt

        [Install]
        WantedBy=multi-user.target
    # Suppress the colored "Fedora CoreOS <version>" OS-release line that
    # console-login-helper-messages prints in the motd after login.
    - name: "console-login-helper-messages-gensnippet-os-release.service"
      mask: true
storage:
  disks:
    - device: /dev/disk/by-id/coreos-boot-disk
      wipe_table: false
      partitions:
        - number: 4
          resize: true
          size_mib: 51200 # root at 50GB
        - number: 5
          size_mib: 0
  trees:
    # The bundled solution manifests, embedded wholesale from the repo's
    # manifests/ directory (resolved via `butane --files-dir`).
    - local: manifests
      path: /etc/ruddervirt/manifests
  files:
    - path: /etc/modprobe.d/ixgbe.conf
      mode: 0644
      contents:
        inline: |
          options ixgbe allow_unsupported_sfp=1
    - path: /etc/yum.repos.d/rancher-k3s-common.repo
      mode: 0644
      contents:
        inline: |
          [rancher-k3s-common-stable]
          name=Rancher K3s Common (stable)
          baseurl=https://rpm.rancher.io/k3s/stable/common/centos/8/noarch
          enabled=1
          gpgcheck=1
          repo_gpgcheck=0
          gpgkey=https://rpm.rancher.io/public.key
    - path: /etc/ruddervirt/manifests/kubevirt-crd.yaml
      overwrite: true
      mode: 0644
      contents:
        source: "https://github.com/kubevirt/kubevirt/releases/download/v1.4.0/kubevirt-cr.yaml"
    - path: /etc/ruddervirt/manifests/kubevirt-operator.yaml
      overwrite: true
      mode: 0644
      contents:
        source:  https://github.com/kubevirt/kubevirt/releases/download/v1.4.0/kubevirt-operator.yaml
    - path: /etc/ruddervirt/manifests/cdi-crd.yaml
      overwrite: true
      mode: 0644
      contents:
        source: https://github.com/kubevirt/containerized-data-importer/releases/download/v1.62.0/cdi-cr.yaml
    - path: /etc/ruddervirt/manifests/cdi-operator.yaml
      overwrite: true
      mode: 0644
      contents:
        source: https://github.com/kubevirt/containerized-data-importer/releases/download/v1.62.0/cdi-operator.yaml
    - path: /etc/NetworkManager/conf.d/no-search-domains.conf
      mode: 0644
      contents:
        inline: |
          [main]
          dns=none
          rc-manager=unmanaged
    - path: /usr/local/bin/k3s
      overwrite: true
      mode: 0755
      contents:
        source: "https://github.com/k3s-io/k3s/releases/download/v1.34.5%2Bk3s1/k3s"
    - path: /var/tmp/k9s.rpm 
      overwrite: true
      mode: 0755
      contents:
        source: "https://github.com/derailed/k9s/releases/download/v0.50.18/k9s_linux_amd64.rpm"
    - path: /etc/kubelet.config
      mode: 0644
      contents:
        inline: |
          apiVersion: kubelet.config.k8s.io/v1beta1
          kind: KubeletConfiguration
          shutdownGracePeriod: 60s
          shutdownGracePeriodCriticalPods: 10s
    - path: /usr/local/bin/ssh-key-sync
      mode: 0777
      contents:
        inline: |
          # placeholder
    - path: /opt/bin/install-kube-ovn.sh
      mode: 0755
      contents:
        source: https://raw.githubusercontent.com/kubeovn/kube-ovn/release-1.15/dist/images/install.sh
    - path: /usr/local/bin/kubectl
      mode: 0777
      contents:
        inline: |
          #!/bin/sh
          exec k3s kubectl "$@"
    - path: /usr/local/bin/render-k3s-config
      mode: 0755
      contents:
        local: scripts/render-k3s-config.sh
    - path: /usr/local/bin/prepare-k3s
      mode: 0755
      contents:
        local: scripts/prepare-k3s.sh
    - path: /usr/local/bin/ruddervirt-setup
      mode: 0755
      contents:
        local: tui/tea-test
    - path: /usr/local/bin/ruddervirt-shell
      mode: 0755
      contents:
        local: scripts/ruddervirt-shell.sh
    - path: /usr/local/bin/brand-ruddervirt
      mode: 0755
      contents:
        local: scripts/brand-ruddervirt.sh
    - path: /etc/profile.d/01-custom-profile.sh
      mode: 0777
      contents:
        inline: |
          alias vim="vi"
          export EDITOR="vi"
          export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    - path: /etc/ruddervirt/ruddervirt-networking.env
      mode: 0644
      overwrite: true
      contents:
        inline: |
          POD_CIDR=10.42.0.0/16
          SVC_CIDR=10.43.0.0/16
          LOCAL_IP=
    - path: /etc/ruddervirt/k3s-config.yaml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          # connecting to another server
          # server: https://192.168.1.5:6443
          # token: MYTOKEN

          # initialize the cluster; only on first server
          # cluster-init: true
          # backup the cluster
          # etcd-s3: true
          # etcd-s3-config-secret: k3s-etcd-snapshot-s3-config

          # bind-address: __LOCAL_IP__
          # advertise-address: __LOCAL_IP__
          # node-ip: __LOCAL_IP__
          # tls-san:
          #   - "__LOCAL_IP__"

          # cluster networking settings; only matters when tailscale operator exists
          # cluster-cidr: __POD_CIDR__
          # service-cidr: __SVC_CIDR__
          # cluster-dns: __CLUSTER_DNS__

          # generic settings; shouldn't ever change
          flannel-backend: none
          kubelet-arg:
            - "config=/etc/kubelet.config"
          node-label:
            - "ruddervirt=metal"
          resolv-conf: /etc/resolv.conf
          disable:
            - "local-storage"
            - "network-policy"
    - path: /etc/zincati/config.d/99-periodic-sat-midnight-us-eastern.toml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [updates]
          enabled = true
          strategy = "periodic"

          [updates.periodic]
          time_zone = "US/Eastern"

          [[updates.periodic.window]]
          days = [ "Sat" ]
          start_time = "00:00"
          length_minutes = 60
    - path: /etc/resolv.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          nameserver 1.1.1.1
          nameserver 8.8.8.8
    - path: /etc/sysctl.d/98-inotify.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          fs.inotify.max_user_instances=8192
          fs.inotify.max_user_watches=524288
    - path: /etc/sysctl.d/99-nebula.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_forward=1
          net.ipv6.conf.all.forwarding=1
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          ruddervirtos-default
    - path: /etc/issue.d/30_ruddervirt-credentials.issue
      mode: 0644
      contents:
        inline: |
          -----------------------------------------------------
          Default RudderVirt OS Credentials: admin / ruddervirt
          -----------------------------------------------------
          